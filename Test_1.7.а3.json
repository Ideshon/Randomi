{
    "entry": "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'MS Shell Dlg 2'; font-size:9pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC - RC </span><span style=\" color:#000000;\">$RANDWORDS(1! 3! a! b! c) - $RANDWORDS(3! 3! a! b! c)</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">M </span><span style=\" color:#000000;\">$MULTIPLY(a! 3)</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC(RC)</span><span style=\" color:#000000;\"> $RANDWORDS(1! 3! a! b! c! $RANDWORDS(1! 3! a! b! c)).</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">M(M) </span><span style=\" color:#000000;\">$MULTIPLY($MULTIPLY(e! 3)! 3).</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC(M) </span><span style=\" color:#000000;\">$RANDWORDS(1! 3! a! b! c! $MULTIPLY(e! 3)).</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">M(RC) </span><span style=\" color:#000000;\">$MULTIPLY($RANDWORDS(1! 3! a! b! c)! 3).</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">v(M)</span><span style=\" color:#000000;\"> {$MULTIPLY(a;! 5)b;c}</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">v(RC)</span><span style=\" color:#000000;\"> {$RANDWORDS(3! 3! a;! b;! c;)d;e}</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">v(RC(M);RC)</span><span style=\" color:#000000;\"> {$RANDWORDS(1! 3! a! b! c! $MULTIPLY(e! 3)); $RANDWORDS(1! 3! a! b! c! $RANDWORDS(1! 3! a! b! c))}.</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC(v) </span><span style=\" color:#000000;\">$RANDWORDS(1! 3! a! b! c! {e; d}).</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">M(v) </span><span style=\" color:#000000;\">$MULTIPLY({e; d}! 3).</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC(v)</span><span style=\" color:#000000;\"> $RANDWORDS(2! 4! {a; b}! {a; b} с)</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">m(M;M) </span><span style=\" color:#000000;\">[+ +$MULTIPLY(a;!3);$MULTIPLY(b;!3)].</span></p>\n<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; color:#000000;\"><br /></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC(d)</span><span style=\" color:#000000;\"> $RANDWORDS(1! 3! a;! b;! c;) - [+,+!;;]</span></p></body></html>",
    "result_output": "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'MS Shell Dlg 2'; font-size:9pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC - RC </span><span style=\" color:#000000;\">a c - a b c</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">M </span><span style=\" color:#000000;\">a a a</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC(RC)</span><span style=\" color:#000000;\"> b.</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">M(M) </span><span style=\" color:#000000;\">e e e e e e e e e.</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC(M) </span><span style=\" color:#000000;\">e e e.</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">M(RC) </span><span style=\" color:#000000;\">a c b a c b a c b.</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">v(M)</span><span style=\" color:#000000;\"> c</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">v(RC)</span><span style=\" color:#000000;\"> a</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">v(RC(M)|RC)</span><span style=\" color:#000000;\"> b.</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC(v) </span><span style=\" color:#000000;\">e.</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">M(v) </span><span style=\" color:#000000;\">e e e.</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC(v)</span><span style=\" color:#000000;\"> b с a</span></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">m(M|M) </span><span style=\" color:#000000;\">a b   a  a  b  b .</span></p>\n<p style=\"-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; color:#000000;\"><br /></p>\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\"><span style=\" font-weight:600; color:#000000;\">RC(d)</span><span style=\" color:#000000;\"> c| a| b| - ,!,</span></p></body></html>",
    "template_label": "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\" \"http://www.w3.org/TR/REC-html40/strict.dtd\">\n<html><head><meta name=\"qrichtext\" content=\"1\" /><style type=\"text/css\">\np, li { white-space: pre-wrap; }\n</style></head><body style=\" font-family:'MS Shell Dlg 2'; font-size:9pt; font-weight:400; font-style:normal;\">\n<p style=\" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;\">$RANDWORDS(min, max, word1, word2, ...) Эта функция будет принимать минимум, максимум и список слов, из которых нужно выбрать случайное количество. $MULTIPLY(word, count) Эта функция будет повторять слово нужное количество раз. Команда &quot;Синонимы&quot; - {variant1 | variant2 | variant3} - вставляет один из вариантов в результирующую строку Если вы хотите пропустить текст - используйте вариант &quot;пусто&quot; - {|variant} Команда Mixin = [ текст 1 | текст 2 | текст 3] - будет случайным образом миксовать эти варианты Вы можете использовать разделитель в mixin - [+,+text 1|text2 ] - вы получите text2,text1. Разделитель может быть любым символом или набором символов: [+==+ a|b] - a==b или b==a Если вы хотите получить специальный символ в вашем результате (\\{\\, \\}\\, \\[\\, \\]\\, \\|\\, \\+\\) - используйте обратный слеш для него - {, }, [, ], |, \\+ Все эти команды могут быть смешаны и вложены во все комбинации: 'начало {aa|bb|{cc1|cc2}} или [a1|{word1|word2}|a3| [aa1|aa2|aa3]]' Вы можете использовать специальные предопределенные функции рандомизации в шаблонах - {случайное целое = $RANDINT(1,10), uuid = $UUID, сейчас = $NOW(%Y-%M-%d)}. Результат будет = 'случайное целое = 4, uuid = 8ae6bdf4-d321-40f6-8c3c-81d20b158acb, сейчас = 2017-08-01' Вы можете определить свои собственные функции рандомизации и использовать их в шаблонах.</p></body></html>",
    "delimiter": ";",
    "func_delimiter": "!"
}